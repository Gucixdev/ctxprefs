{
  "manifest_version": 2,
  "name": "ctxprefs",
  "version": "0.1.0",
  "description": "Per-container headers and proxy for Firefox containers.",
  "permissions": ["webRequest", "webRequestBlocking", "proxy", "storage", "contextualIdentities", "cookies", "<all_urls>"],
  "browser_specific_settings": { "gecko": { "id": "ctxprefs@example.invalid", "strict_min_version": "115.0" } },
  "background": { "scripts": ["background.js"], "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
